{
    "name": "filesearch-gui",
    "private": true,
    "version": "1.0.0",
    "description": "Private, local search for a law firm's documents",
    "author": "Rodrigo Allende",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "build:web": "tsc && vite build",
        "build": "tsc && vite build && electron-builder --publish never",
        "preview": "vite preview",
        "license": "node scripts/license.mjs"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "date-fns": "^2.30.0",
        "framer-motion": "^12.23.24",
        "lucide-react": "^0.294.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^7.9.6",
        "recharts": "^3.5.1",
        "tailwind-merge": "^2.6.0",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^18.2.37",
        "@types/react-dom": "^18.2.15",
        "@types/yauzl": "^2.10.3",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.16",
        "electron": "^39.2.4",
        "electron-builder": "^26.15.3",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.3.5",
        "typescript": "^5.2.2",
        "vite": "^7.2.4",
        "vite-plugin-electron": "^0.15.4",
        "vite-plugin-electron-renderer": "^0.14.5",
        "vitest": "^3.2.7"
    },
    "build": {
        "appId": "com.allende.filesearch",
        "productName": "File Search",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "build/runtime",
                "to": ".",
                "filter": [
                    "**/*"
                ]
            }
        ],
        "mac": {
            "category": "public.app-category.utilities"
        },
        "win": {
            "target": "nsis",
            "artifactName": "FileSearch-Setup-${version}.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "deleteAppDataOnUninstall": false
        },
        "linux": {
            "target": "AppImage"
        },
        "publish": null
    },
    "engines": {
        "node": ">=20.19"
    }
}
